package ve.edu.unet;



import java_cup.runtime.*;

import ve.edu.unet.nodosAST.*;

import java.io.InputStreamReader;





parser code {:



/***********

SymbolFactory es una nueva caracteristica que ha sido aadida a las version 11a de cup, la cual facilita la implementacion de clases Symbol personalizadas

, esto debido a que dicha clase no provee mucha informacin de contexto que podria ser util para el analisis semantico o ayudar en la construccion del AST

Mas informacion en: http//4thmouse.com/index.php/2007/02/15/using-custom-symbols-in-cup/

***********/

	@SuppressWarnings("deprecation")

	public static void main(String args[]) throws Exception {

		SymbolFactory sf = new DefaultSymbolFactory();

		parser parser_obj;

		if (args.length==0) 

			parser_obj=new parser(new Lexico(new InputStreamReader(System.in),sf),sf);

		else

			parser_obj=new parser(new Lexico(new InputStreamReader(new java.io.FileInputStream(args[0])),sf),sf);



		parser_obj.parse();

		NodoBase root=parser_obj.action_obj.getASTroot();

		System.out.println();

		System.out.println("IMPRESION DEL AST GENERADO");

		System.out.println();

        Util.imprimirAST(root);

		TablaSimbolos ts = new TablaSimbolos();

		ChequeadorSemantico semantico = new ChequeadorSemantico(ts);

		boolean exitoSemantico = semantico.analizar(root);

		ts.ImprimirClaves();

		if (!exitoSemantico) {
			System.err.println();
			System.err.println("*********************************************************");
			System.err.println("       ERRORES SEMANTICOS DETECTADOS EN LA COMPILACION   ");
			System.err.println("*********************************************************");
			semantico.imprimirErrores();
			System.err.println("*********************************************************");
			System.err.println();
			System.out.println("Compilacion detenida debido a errores semanticos.");
			return;
		}

		Generador.setTablaSimbolos(ts);

		Generador.generarCodigoObjeto(root);

	}



:}



action code {:

	private boolean debug=true;

	private NodoBase ast=null;

	private int lineanum=0;

	

	//Debe ser llamada solo despues de un parse(), en caso contrario retornara null siempre;

	public NodoBase getASTroot(){

		return ast;

	}

	

:}



/* Simbolos Terminales */



terminal IF;

terminal THEN;

terminal ELSE;

terminal END;

terminal REPEAT;

terminal UNTIL;

terminal READ;

terminal WRITE;

terminal String ID;

terminal String NUM;

terminal ASSIGN;

terminal EQ;

terminal LT;

terminal PLUS;

terminal MINUS;

terminal TIMES;

terminal OVER;

terminal LPAREN;

terminal RPAREN;

terminal SEMI;



/* Agregar los cambios hechos en lexico */



terminal INT;

terminal BOOL;

terminal STRING;

terminal TRUE;

terminal FALSE;

terminal String STR;



/* Funciones */



terminal FUNCTION;

terminal PROCEDURE;

terminal RETURN;



/* Arreglos */



terminal LBRACKET;

terminal RBRACKET;

terminal COMMA;



/* Comparadores */

terminal GT;

terminal LE;

terminal GE;

terminal NE;

terminal AND;

terminal OR;

terminal NOT;



/* Simbolos No Terminales */

non terminal program;

non terminal NodoBase stmt_seq;

non terminal NodoBase stmt;

non terminal NodoBase if_stmt;

non terminal NodoBase repeat_stmt;

non terminal NodoBase assign_stmt;

non terminal NodoBase read_stmt;

non terminal NodoBase write_stmt;

non terminal NodoBase exp;

non terminal NodoBase simple_exp;

non terminal NodoBase term;

non terminal NodoBase factor;



/* Nuevos valores de no terminales */



non terminal String tipo;

non terminal NodoBase var_decl;

non terminal NodoBase vec_decl;



non terminal NodoBase func_decl;

non terminal NodoBase proc_decl;

non terminal NodoBase params;

non terminal NodoBase param_list;

non terminal NodoBase param;

non terminal NodoBase return_stmt;



non terminal NodoBase args;

non terminal NodoBase arg_list;



/* Precedencia de operadores */



precedence left OR;

precedence left AND;

precedence right NOT;

precedence nonassoc EQ, LT, GT, LE, GE, NE;



precedence left PLUS, MINUS;

precedence left TIMES, OVER;





/* REGLAS GRAMATICALES */

program     ::= stmt_seq:s	{: if(debug) System.out.println("\t regla 1"); 

					ast = s;

					:}

		;



stmt_seq    ::= stmt_seq:ini SEMI stmt:sent	{: if(debug) System.out.println("\t regla 2a"); 

						NodoBase hijoActual = ini;

						if(hijoActual !=null){

							while(hijoActual.TieneHermano()){

								hijoActual = hijoActual.getHermanoDerecha();

							}

							hijoActual.setHermanoDerecha(sent);

							RESULT=ini;

						}else{

							RESULT=sent;

						}

						:}

            | stmt:sent	{: if(debug) System.out.println("\t regla 2b"); 

				RESULT=sent;				

				:}

		;



stmt        ::= if_stmt:sif	{: if(debug) System.out.println("\t regla 3a"); 

					RESULT=sif;

					:}

            | repeat_stmt:srep	{: if(debug) System.out.println("\t regla 3b"); 

						RESULT=srep;

						:}

            | assign_stmt:sasi	{: if(debug) System.out.println("\t regla 3c"); 

						RESULT=sasi;

						:}

            | read_stmt:slec	{: if(debug) System.out.println("\t regla 3d"); 

					RESULT=slec;

					:}

            | write_stmt:sesc	{: if(debug) System.out.println("\t regla 3e"); 

					RESULT=sesc;

					:}

			





			/* Nuevas sentencias */







			| var_decl:sv       {: RESULT=sv; :}

            | vec_decl:sarr     {: RESULT=sarr; :}

            | func_decl:sf      {: RESULT=sf; :}

            | proc_decl:sp      {: RESULT=sp; :}

            | return_stmt:sr    {: RESULT=sr; :}

            | ID:nombre args:a  {: if(debug) System.out.println("\t llamada a procedimiento: " + nombre);

                                   RESULT = new NodoLlamada(nombre.toString(), a, nombreleft);

                                :}

            | error	{: if(debug) System.out.println("\t regla 3f"); 

				System.out.println("Ocurrio error en cup # 0004 C");

				RESULT=null;

				:}

            ;









if_stmt     ::= IF:i exp:ex THEN stmt_seq:pthen END	{: if(debug) System.out.println("\t regla 4a"); 

		RESULT = new NodoIf(ex,pthen,ileft);

		:}

		| IF:i exp:ex THEN stmt_seq:pthen ELSE stmt_seq:pelse END	{: if(debug) System.out.println("\t regla 4b"); 

		RESULT = new NodoIf(ex,pthen,pelse,ileft);		

		:}

		;



repeat_stmt ::= REPEAT:r stmt_seq:cuerpo UNTIL exp:prueba	{: if(debug) System.out.println("\t regla 5"); 

							RESULT = new NodoRepeat(cuerpo,prueba,rleft);

							:}

		;



/* modificado */





assign_stmt ::= ID:variable ASSIGN exp:ex

                {: if(variable!=null) RESULT = new NodoAsignacion(variable.toString(),ex,variableleft);

                   else RESULT = null;

                :}

            /* A[i*2+1] := 10 */

            | ID:variable LBRACKET exp:idx RBRACKET ASSIGN exp:ex

                {: if(debug) System.out.println("\t asignacion arreglo: " + variable);

                   RESULT = new NodoAsignacion(variable.toString(), ex, idx, variableleft);

                :}

            ;









read_stmt   ::= READ:r ID:variable	{: if(debug) System.out.println("\t regla 7"); 

					System.out.println("Leyendo Variable");

					if(variable!=null)

					RESULT = new NodoLeer(variable.toString(), rleft);

					else{

					RESULT = null;

					System.out.println("Ocurrio error en cup # 0002");

					}

					:}

		;



write_stmt  ::= WRITE:w exp:ex	{: if(debug) System.out.println("\t regla 8"); 

					RESULT= new NodoEscribir(ex, wleft);

					:}

		;







		/* tipos y declaraciones de variables */







tipo        ::= INT       {: RESULT = "int"; :}

            | BOOL      {: RESULT = "bool"; :}

            | STRING    {: RESULT = "string"; :}

            ;



/* int x */

var_decl    ::= tipo:t ID:variable

                {: if(debug) System.out.println("\t declaracion variable: " + variable);

                   RESULT = new NodoDeclaracion(t, variable.toString(), variableleft);

                :}

            ;



/* int A[10] */

vec_decl    ::= tipo:t ID:variable LBRACKET NUM:tam RBRACKET

                {: if(debug) System.out.println("\t declaracion arreglo: " + variable + "[" + tam + "]");

                   RESULT = new NodoDeclaracion(t, variable.toString(), Integer.valueOf(tam), variableleft);

                :}

            ;



		/* funciones y procedimientos */



params      ::= LPAREN param_list:pl RPAREN  {: RESULT = pl; :}

            | LPAREN RPAREN                  {: RESULT = null; :}

            ;



param_list  ::= param_list:ini COMMA param:p

                {:

                    NodoBase hijoActual = ini;

                    if(hijoActual != null){

                        while(hijoActual.TieneHermano()){

                            hijoActual = hijoActual.getHermanoDerecha();

                        }

                        hijoActual.setHermanoDerecha(p);

                        RESULT = ini;

                    } else {

                        RESULT = p;

                    }

                :}

            | param:p

                {: RESULT = p; :}

            ;



param       ::= tipo:t ID:nombre

                {: RESULT = new NodoDeclaracion(t, nombre.toString(), nombreleft); :}

            ;



/* procedure saludar(int x) ... end */

proc_decl   ::= PROCEDURE:pr ID:nombre params:p stmt_seq:cuerpo END

                {: if(debug) System.out.println("\t declaracion procedimiento: " + nombre);

                   RESULT = new NodoSubrutina(null, nombre.toString(), p, cuerpo, prleft);

                :}

            ;



/* function int suma(int a, int b) ... end */

func_decl   ::= FUNCTION:f tipo:t ID:nombre params:p stmt_seq:cuerpo END

                {: if(debug) System.out.println("\t declaracion funcion: " + nombre);

                   RESULT = new NodoSubrutina(t, nombre.toString(), p, cuerpo, fleft);

                :}

            ;



return_stmt ::= RETURN:r exp:ex

                {: if(debug) System.out.println("\t return exp");

                   RESULT = new NodoReturn(ex, rleft);

                :}

            | RETURN:r

                {: if(debug) System.out.println("\t return vacio");

                   RESULT = new NodoReturn(rleft);

                :}

            ;



		/* argumentos de llamada */



args        ::= LPAREN arg_list:al RPAREN    {: RESULT = al; :}

            | LPAREN RPAREN                  {: RESULT = null; :}

            ;



arg_list    ::= arg_list:ini COMMA exp:ex

                {:

                    NodoBase hijoActual = ini;

                    if(hijoActual != null){

                        while(hijoActual.TieneHermano()){

                            hijoActual = hijoActual.getHermanoDerecha();

                        }

                        hijoActual.setHermanoDerecha(ex);

                        RESULT = ini;

                    } else {

                        RESULT = ex;

                    }

                :}

            | exp:ex

                {: RESULT = ex; :}

            ;







/* modificado */



exp         ::= simple_exp:exI LT:op simple_exp:exD   {: RESULT = new NodoOperacion(exI, tipoOp.menor, exD, opleft); :}

            | simple_exp:exI EQ:op simple_exp:exD   {: RESULT = new NodoOperacion(exI, tipoOp.igual, exD, opleft); :}

            | simple_exp:exI GT:op simple_exp:exD   {: RESULT = new NodoOperacion(exI, tipoOp.mayor, exD, opleft); :}

            | simple_exp:exI LE:op simple_exp:exD   {: RESULT = new NodoOperacion(exI, tipoOp.menor_igual, exD, opleft); :}

            | simple_exp:exI GE:op simple_exp:exD   {: RESULT = new NodoOperacion(exI, tipoOp.mayor_igual, exD, opleft); :}

            | simple_exp:exI NE:op simple_exp:exD   {: RESULT = new NodoOperacion(exI, tipoOp.distinto, exD, opleft); :}

            | exp:exI AND:op exp:exD                {: RESULT = new NodoOperacion(exI, tipoOp.and, exD, opleft); :}

            | exp:exI OR:op exp:exD                 {: RESULT = new NodoOperacion(exI, tipoOp.or, exD, opleft); :}

            | NOT:op exp:ex                         {: RESULT = new NodoOperacion(tipoOp.not, ex, opleft); :}

            | simple_exp:ex                      {: RESULT = ex; :}

            ;







simple_exp  ::= simple_exp:exI PLUS:op term:exD	{: if(debug) System.out.println("\t regla 10a"); 

							RESULT = new NodoOperacion(exI,tipoOp.mas,exD,opleft);

							:}

		| simple_exp:exI MINUS:op term:exD	{: if(debug) System.out.println("\t regla 10b"); 

							RESULT = new NodoOperacion(exI,tipoOp.menos,exD,opleft);

							:}

		| term:ex	{: if(debug) System.out.println("\t regla 10c"); 

				RESULT=ex;

				:}

		;



term        ::= term:exI TIMES:op factor:exD	{: if(debug) System.out.println("\t regla 11a"); 

							RESULT = new NodoOperacion(exI,tipoOp.por,exD,opleft);

							:}

		| term:exI OVER:op factor:exD	{: if(debug) System.out.println("\t regla 11b"); 

						RESULT = new NodoOperacion(exI,tipoOp.entre,exD,opleft);

						:}

		| factor:ex	{: if(debug) System.out.println("\t regla 11c"); 

					RESULT=ex;

					:}

		;







/* modificado */





factor      ::= LPAREN exp:ex RPAREN             {: RESULT = ex; :}

            | NUM:valor                          {: RESULT = new NodoValor(Integer.parseInt(valor), valorleft); :}

            | ID:variable                        {: RESULT = new NodoIdentificador(variable.toString(), variableleft); :}

            /* Acceso a arreglo: A[i*2+1] */

            | ID:variable LBRACKET exp:idx RBRACKET {: RESULT = new NodoIdentificador(variable.toString(), idx, variableleft); :}

            /* Llamada a funcion: suma(1, 2) */

            | ID:nombre args:a                   {: RESULT = new NodoLlamada(nombre.toString(), a, nombreleft); :}

            /* Literales nuevos */

            | TRUE:t                             {: RESULT = new NodoValor(true, tleft); :}

            | FALSE:f                            {: RESULT = new NodoValor(false, fleft); :}

            | STR:cad                            {: RESULT = new NodoValor(cad.toString(), cadleft); :}

            | error                              {: RESULT = null; :}

            ;

